source "https://rubygems.org"

# Mirrors the gem set GitHub Pages builds with, so local previews match
# production. GitHub Pages ignores this file in its own build (it always
# uses its pinned versions) — it exists only for `bundle exec jekyll serve`.
gem "github-pages", group: :jekyll_plugins

# Required for `jekyll serve` on Ruby 3.0+ (WEBrick left the standard library).
gem "webrick", "~> 1.8"
